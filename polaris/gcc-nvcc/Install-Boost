#!/bin/bash

set -euo pipefail

BOOST_VERSION=1.89.0
BOOST_VERSION_U=1_89_0
ETKPATH="${ETKPATH:-/home/jkalinan/EinsteinToolkit}"
BOOST_PREFIX="${ETKPATH}/boost-gcc-nvcc"
BOOST_WORK="${ETKPATH}/dependencies/boost-${BOOST_VERSION}"
BOOST_ARCHIVE="${BOOST_WORK}/boost_${BOOST_VERSION_U}.tar.bz2"
BOOST_SOURCE="${BOOST_WORK}/boost_${BOOST_VERSION_U}"
BUILD_JOBS="${BUILD_JOBS:-16}"

mkdir -p "${BOOST_WORK}"

if [[ ! -f "${BOOST_ARCHIVE}" ]]; then
  curl -fL \
    "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_U}.tar.bz2" \
    -o "${BOOST_ARCHIVE}"
fi

if [[ ! -d "${BOOST_SOURCE}" ]]; then
  tar -xjf "${BOOST_ARCHIVE}" -C "${BOOST_WORK}"
fi

cd "${BOOST_SOURCE}"
./bootstrap.sh --prefix="${BOOST_PREFIX}" --with-libraries=filesystem,system
./b2 -j"${BUILD_JOBS}" \
  toolset=gcc \
  cxxstd=17 \
  variant=release \
  threading=multi \
  link=static \
  --with-filesystem \
  --with-system \
  install

echo "Boost ${BOOST_VERSION} installed in ${BOOST_PREFIX}"
